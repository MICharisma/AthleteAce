<% content_for :title, "Goal: #{@goal.quest.name}" %>

<%= goal_detail_page @goal, notice: notice do %>
  <%= goal_status_section @goal %>

  <%= quest_description_section @goal.quest %>

  <%= achievements_section @required_highlights, "Required Achievements", goal: @goal, goal_entries: @goal_entries, engagement_summary: @engagement_summary %>

  <% if @optional_highlights.any? %>
    <%= achievements_section @optional_highlights, "Optional Achievements", required: false, goal: @goal, goal_entries: @goal_entries, engagement_summary: @engagement_summary %>
  <% end %>

  <%= abandon_quest_section @goal %>
<% end %>
