<% your_rating = current_ace&.rating_for(record, spectrum) %>
<% summary = record.ratings_on(spectrum).pick(Arel.sql("COUNT(*)"), Arel.sql("AVG(value)")) %>
<% count, average = summary %>
<% average = average&.to_f %>
<% row_id = rating_row_id record, spectrum %>
<% saved = local_assigns.fetch :saved, false %>
<% dimension = spectrum.rating_dimension %>

<%= tag.div id: row_id, class: "rating-slider-instance", style: "--rating-position: #{dimension.position(your_rating&.value || 0) * 100}%", data: { spectrum_id: spectrum.id, rated: your_rating.present?, dimension: dimension.to_h.to_json } do %>
  <%= tag.div class: "slider-header" do %>
    <%= tag.label spectrum.name, for: "#{row_id}_input", class: "slider-label" %>
    <%= tag.div class: "slider-score" do %>
      <% if ace_signed_in? && !your_rating %>
        <%= tag.button "Rate neutral", type: "button", class: "rate-neutral", data: { action: "rating-slider#rateNeutral" } %>
      <% end %>
      <%= tag.span formatted_rating(your_rating&.value), class: "slider-value" %>
    <% end %>
  <% end %>
  <%= tag.div class: "slider-track" do %>
    <% if average %>
      <%= tag.div class: "average-track", aria: { hidden: true } do %>
        <%= tag.span "", class: "average-marker", style: "left: #{(average - dimension.minimum) * 100 / (dimension.maximum - dimension.minimum)}%", title: "Aces average #{formatted_rating average}" %>
      <% end %>
    <% end %>
    <%= tag.input type: "range", id: "#{row_id}_input", min: dimension.minimum, max: dimension.maximum, step: 1,
      value: your_rating&.value || 0, disabled: !ace_signed_in?, class: "rating-slider-input",
      title: t(".endpoints", low: spectrum.low_label, high: spectrum.high_label),
      aria: { describedby: "#{row_id}_summary", keyshortcuts: "Shift+ArrowLeft Shift+ArrowRight Shift+ArrowUp Shift+ArrowDown" }, data: {
        rating_slider_target: "slider", rating_slider_spectrum_id_param: spectrum.id,
        rating_slider_url: polymorphic_path([record, :ratings]),
        action: "input->rating-slider#updateValue change->rating-slider#submitRating keydown->rating-slider#adjustWithKeyboard pointerdown->rating-slider#startDrag lostpointercapture->rating-slider#cancelDrag"
      } %>
    <% if ace_signed_in? %>
      <%= tag.div class: "rating-handle-track" do %>
        <%= tag.span "", class: "rating-drag-handle", aria: { hidden: true }, data: {
          action: "pointerdown->rating-slider#startDrag"
        } %>
      <% end %>
    <% end %>
    <% unless ace_signed_in? %>
      <%= tag.button "", type: "button", class: "rating-sign-in-trigger",
        aria: { label: "Sign in to rate #{spectrum.name}", describedby: "#{row_id}_status" },
        data: { action: "rating-slider#promptSignIn" } %>
    <% end %>
  <% end %>
  <%= tag.div id: "#{row_id}_summary", class: "rating-summary" do %>
    <% if average %>
      <%= tag.span class: "rating-average" do %>
        <%= tag.span "", class: "average-key", aria: { hidden: true } %>
        <%= tag.span "Aces average" %>
        <%= tag.strong formatted_rating(average) %>
      <% end %>
      <%= tag.span pluralize(count, "rating"), class: "rating-count" %>
    <% else %>
      <%= tag.span "No ratings yet" %>
    <% end %>
  <% end %>
  <%= tag.div id: "#{row_id}_status", class: "slider-status", role: "status", aria: { live: "polite" } do %>
    <%= tag.span saved ? "Saved" : "", class: "status-indicator", data: { rating_slider_target: "status" } %>
    <% unless ace_signed_in? %>
      <%= link_to "Sign in", new_ace_session_path, class: "rating-sign-in-link hidden" %>
    <% end %>
    <%= tag.button "Retry", type: "button", class: "rating-retry hidden", data: { action: "rating-slider#retry" } %>
  <% end %>
<% end %>
