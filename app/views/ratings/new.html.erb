<% content_for :title, "Rate #{@rated.name}" %>

<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-3xl mb-6">Rate <%= @rated.name %></h1>

  <div class="bg-white rounded-lg shadow-md overflow-hidden p-6 mb-6">
    <div class="mb-6">
      <h2 class="font-semibold text-xl mb-2">About <%= @rated.name %></h2>
      <% if @rated_type == 'player' %>
        <p class="text-gray-600">
          Team: <%= link_to @rated.team.name, team_path(@rated.team), class: "text-blue-600 hover:underline" %>
        </p>
        <% if @rated.primary_position %>
          <p class="text-gray-600">Position: <%= @rated.primary_position.name %></p>
        <% end %>
      <% elsif @rated_type == 'team' %>
        <p class="text-gray-600">
          League: <%= link_to @rated.league.name, league_path(@rated.league), class: "text-blue-600 hover:underline" %>
        </p>
        <% if @rated.stadium %>
          <p class="text-gray-600">Stadium: <%= link_to @rated.stadium.name, stadium_path(@rated.stadium), class: "text-blue-600 hover:underline" %></p>
        <% end %>
      <% end %>
    </div>

    <% if @spectrum_id.present? %>
      <h2 class="font-semibold text-xl mb-4">Rate on <%= @spectrum.name %></h2>
      <%= render "form", rating: @rating, spectrum: @spectrum, 
                 url: polymorphic_path([@rated, :ratings]),
                 cancel_path: polymorphic_path(@rated) %>
    <% else %>
      <h2 class="font-semibold text-xl mb-4">Select a Spectrum to Rate On</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <% @spectrums.each do |spectrum| %>
          <%= link_to new_polymorphic_path([@rated, :rating], spectrum_id: spectrum.id), class: "block p-4 border rounded-lg hover:bg-blue-50 hover:border-blue-300 transition-colors" do %>
            <h3 class="font-medium text-lg mb-1"><%= spectrum.name %></h3>
            <p class="text-gray-600 text-sm mb-2"><%= spectrum.description %></p>
            <div class="flex justify-between text-xs">
              <span class="text-red-500"><%= spectrum.low_label %></span>
              <span class="text-green-500"><%= spectrum.high_label %></span>
            </div>
          <% end %>
        <% end %>
      </div>
      
      <div class="mt-4">
        <%= link_to "Back", polymorphic_path(@rated), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-200 inline-block font-medium" %>
      </div>
    <% end %>
  </div>
</div>
