<% content_for :title, @figure.display_name %>
<section class="round-panel">
  <h1 class="page-title"><%= @figure.display_name %></h1>
  <% @figure.players.includes(:sport).each do |player| %>
    <%= link_to ["Athletic profile", player.sport&.name].compact.join(": "), player_path(player), class: "tool-link" %>
  <% end %>
</section>
<%= render "staff_tenures/list", staff_tenures: @staff_tenures %>
