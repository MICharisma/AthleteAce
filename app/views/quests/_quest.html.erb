<%= tag.article id: dom_id(quest), class: "quest-card", **draggable_listable_attrs(quest, data: { entity: "quest" }) do %>
  <%= tag.div class: "quest-card-top" do %>
    <%= icon "script", size: 28 %>
    <%= quest_achievements_indicator quest %>
  <% end %>
  <%= moderation_notice quest %>
  <%= tag.h2 quest_card_title_link(quest) %>
  <%= tag.p quest.description, class: "quest-card-description" %>
  <% if (participants = quest_participants_badge quest) %>
    <%= tag.div participants, class: "quest-card-meta" %>
  <% end %>
  <% if (goal = quest_goal quest) %><%= render "quests/progress", goal: goal %><% end %>
  <%= curation_bar_for quest, summary: @engagement_summary %>
  <%= quest_card_actions quest %>
<% end %>
