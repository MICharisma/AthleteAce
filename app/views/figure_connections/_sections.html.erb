<p class="round-caption connection-note">Sourced connections are attributed to their sources and reviewed by editors. They don't imply beliefs, medical effects or a team's position, and they're separate from fan ratings and posts.</p>
<% [ [ "businesses", "Businesses", business_ties, "business_card", "No sourced business connections have been recorded yet." ],
     [ "practices", "Practices", practice_ties, "practice_card", "No sourced practices have been recorded yet." ],
     [ "values", "Values and wisdom", statements, "statement_card", "No sourced statements have been recorded yet." ] ].each do |anchor, title, claims, card, empty| %>
  <section class="round-panel" id="<%= anchor %>" aria-labelledby="<%= anchor %>-title">
    <h2 id="<%= anchor %>-title" class="profile-section-title"><%= title %></h2>
    <% if claims.any? %>
      <div class="connection-cards"><% claims.each do |claim| %><%= render "figure_connections/#{card}", claim: claim %><% end %></div>
    <% else %>
      <p class="round-caption"><%= empty %></p>
    <% end %>
  </section>
<% end %>
